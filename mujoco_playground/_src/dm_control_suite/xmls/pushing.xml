<mujoco model="1D_Pushing">
    <option gravity="0 0 -9.81" iterations="1" timestep="0.002" impratio="100"/>

    <statistic center="0.15 0 0.1" extent="0.5"/>

    <visual>
        <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
        <rgba haze="0.15 0.25 0.35 1"/>
        <global azimuth="0" elevation="-20"/>
    </visual>

    <asset>
        <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
        <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
            markrgb="0.8 0.8 0.8" width="300" height="300"/>
        <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    </asset>

    <worldbody>
        <camera name="track" pos="0.15 -0.8 0.8" xyaxes="1 0 0 0 0.707 0.707" fovy="40"/>
        <camera name="side_view" pos="0.15 -0.8 0.8" xyaxes="1 0 0 0 0.707 0.707" fovy="40"/>

        <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
        <geom name="floor" size="0 0 0.05" type="plane" material="groundplane" friction="1 0.1 0.1"/>

        <body name="ball" pos="0.0 0 0.1">
            <joint name="ball_x" type="slide" axis="1 0 0" damping="10"/>
            <geom name="ball_geom" type="sphere" size="0.1" mass="1.0" rgba="0.8 0.2 0.2 1" solref="0.02 1" solimp="0.015 1 0.031 0.5 2"/>
        </body>

        <body name="box" pos="0.20 0 0.1">
            <joint name="box_x" type="slide" axis="1 0 0" damping="10"/>
            <geom name="box_geom" type="box" size="0.1 0.1 0.1" mass="10.0" rgba="0.6 0.6 0.6 1" solref="0.02 1" solimp="0.015 1 0.031 0.5 2"/>
        </body>

        <geom name="target" type="box" size="0.01 0.15 0.15" pos="0.4 0 0.1" rgba="0 1 0 0.5" contype="0" conaffinity="0"/>
    </worldbody>

    <actuator>
        <position name="ball_position" joint="ball_x" kp="100" ctrlrange="-1 1"/>
    </actuator>

    </mujoco>
